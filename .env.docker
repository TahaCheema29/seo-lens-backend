# Docker Environment Variables
# Copy this to .env.local before running docker-compose

# App Settings
DEBUG=false
APP_NAME=SEO Lens

# Google API Keys
GOOGLE_CLOUD_API_KEY_1=
GOOGLE_CLOUD_API_KEY_2=
GOOGLE_CLOUD_API_KEY_3=
GOOGLE_CLOUD_CSE=
PAGESPEED_API_KEY=

# Redis (Docker service)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Database (Docker service)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/seo_lens

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440